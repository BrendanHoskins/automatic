{
  "manifest_version": 3,
  "name": "Kipu Shift Note Filler",
  "version": "1.3.0",
  "description": "Auto-fills a standard shift note for every client on a chosen building's Kipu occupancy board.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["https://*.kipuworks.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kipu Shift Note Filler",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://*.kipuworks.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
